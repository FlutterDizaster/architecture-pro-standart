Rel(ib, conv, "Онлайн-заявки сразу, без суточного обмена", "Kafka")
Rel(conv, ib, "Условия кредитов, результаты скоринга, статусы заявок", "Kafka")
Rel(conv, scor, "Полный и упрощённый скоринг", "REST")
Rel(scor, bki, "Кредитная история", "REST")
Rel(conv, abs, "Одобренные кредиты раз в сутки, как сейчас", "БД")
Rel(abs, conv, "Заявки из отделений раз в сутки, как сейчас", "БД")
Rel(ib, sms, "СМС-коды и СМС о статусах", "HTTPS")
Rel(sms, tel, "СМС")
Rel(front, conv, "Находит заявку с сайта и продолжает её после идентификации")
Rel(front, abs, "Заводит нового клиента и счёт; заявка для клиента без онлайн-заявки")
Rel(cred_bo, conv, "Рассматривает заявки, предодобренные в приоритете")

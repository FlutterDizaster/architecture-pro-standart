@startuml C4_context_credit_online
!include <C4/C4_Context>
LAYOUT_TOP_DOWN()

title Заявка на кредит онлайн: диаграмма контекста

Person(client, "Клиент", "Новый клиент на сайте или клиент интернет-банка")
Person(front, "Менеджер отделения")
Person(cred_bo, "Менеджер кредитования")

System(site, "Сайт", "Предложения по кредитам, заявка нового клиента")
System(ib, "Интернет-банк", "Кредиты, предодобренные предложения, заявка")
System(conv, "Кредитный конвейер", "Новый процесс онлайн-заявки")
System(scor, "Система кредитного скоринга", "Оценка клиента, новый упрощённый скоринг по БКИ")

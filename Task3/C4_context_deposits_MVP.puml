@startuml C4_context_deposits_MVP
!include <C4/C4_Context>
LAYOUT_TOP_DOWN()

title Открытие депозитов онлайн (MVP): диаграмма контекста

Person(client, "Клиент", "Новый клиент на сайте или клиент интернет-банка")
Person(cc_op, "Оператор кол-центра")
Person(dep_bo, "Менеджер бэк-офиса депозитов")
Person(cred_bo, "Менеджер бэк-офиса кредитов")
Person(front, "Менеджер отделения")

System(site, "Сайт", "Каталог депозитов, заявка нового клиента")
System(ib, "Интернет-банк", "Депозиты и персональные ставки, заявка на депозит. Депозитный функционал вынесен в новые сервисы")
System(abs, "АБС", "Справочник ставок, обработка заявок, открытие депозитов")
System(ccs, "Система кол-центра", "Платформа подрядчика, дорабатываем модуль заявок с сайта")
System(sms, "СМС-шлюз", "Поддерживает IT-отдел банка")
System_Ext(tel, "Телеком-оператор", "Доставка СМС")

Rel(client, site, "Смотрит ставки, оставляет заявку", "HTTPS")
Rel(client, ib, "Смотрит ставки, подаёт заявку, подтверждает СМС-кодом", "HTTPS")
Rel(site, ib, "Ставки и приём заявок через API депозитного сервиса", "HTTPS, REST")
Rel(ib, abs, "Новые заявки, ставки и статусы заявок", "Kafka")
Rel(ib, ccs, "Заявки новых клиентов с сайта", "Kafka")
Rel(ib, sms, "СМС-коды и уведомления", "HTTPS")
Rel(cc_op, ccs, "Звонит по заявке, предлагает условия")
Rel(dep_bo, abs, "Ведёт ставки, подтверждает ставку по заявке")
Rel(cred_bo, abs, "Ведёт кредитную часть ставок")
Rel(front, abs, "Открывает депозит новому клиенту после идентификации")
Rel(sms, tel, "СМС")
@enduml
